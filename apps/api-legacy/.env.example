# Arunaki API Environment Variables

# Security & Authentication (REQUIRED)
# Generate a random 32-character hex string for the API Key (e.g. openssl rand -hex 32)
ARUNAKI_API_KEY=your-secure-api-key-here
# Generate a random 32-character hex string for the Vault Key (e.g. openssl rand -hex 32)
ARUNAKI_VAULT_KEY=your-secure-vault-key-here

# Server
PORT=3000

# Database
DATABASE_URL="file:./dev.db"

# AI Provider Configuration (OpenRouter / OpenAI)
AI_API_KEY=your-api-key-here
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Reasoning Pruning (default ON — speed over deliberation)
# Force a reasoning_effort for openai-compatible providers (low|medium|high).
# Set to "off" to disable all reasoning params (no reasoning_effort, no thinking).
# Leave unset to derive automatically from the model capability map.
ARUNAKI_REASONING_EFFORT=
# Cap Anthropic extended-thinking tokens (default 1024).
ANTHROPIC_THINKING_BUDGET_TOKENS=1024
# Inject the "[REASONING EFFORT: LOW]" concise-reasoning directive into the
# system prompt (default true). Set to "false" to skip it.
ARUNAKI_CONCISE_REASONING=true

# External Tools & Search Providers
TAVILY_API_KEY=your-tavily-api-key-here

# Storage
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=info
