# so suite fixtures never leak and legit repo files stay visible.
workspace-demo/**
!workspace-demo/.arunaki/
!workspace-demo/.arunaki/**

# Runtime sessions & workspace caches
.arunaki/sessions/
**/.arunaki/sessions/
**/.arunaki/backups/
*.traineddata
