{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "ARUNAKI_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "ARUNAKI_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@arunaki/engine#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@arunaki/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
